<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:l="sap.ui.layout"
	xmlns:u="sap.ui.unified">
	<Dialog
		id="uploadDialog"
		title="{i18n>upload}"
		class="sapUiContentPadding">
		<content>
			<l:VerticalLayout id="_IDGenVerticalLayout1">
				<u:FileUploader
					id="fileUploader"
					name="myFileUpload"
					fileType="xlsx"
					change="handleFileChange"
					typeMissmatch="handleFileTypeMissmatch"/>
				<Button id="_IDGenButton1"
					text="{i18n>uploadFile}"
					press="handleUploadPress"/>
			</l:VerticalLayout>
		</content>
		<buttons>        
            <Button id="_IDGenButton2" press="onCloseDialog" text="{i18n>cancel}"/>
        </buttons>
	</Dialog>
</core:FragmentDefinition>